<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal"
    android:padding="20dp">

    <!-- Header title -->
    <TextView
        android:id="@+id/tv_title_shop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THE SHOP"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Category TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_shop_categories"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="16dp"
        android:background="@color/bg_principal"
        app:tabBackground="@null"
        app:tabIndicatorColor="@color/azul_neon"
        app:tabSelectedTextColor="@color/azul_neon"
        app:tabTextColor="@color/gray_text"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Body2"
        app:layout_constraintTop_toBottomOf="@id/tv_title_shop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERIFÉRICOS" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKINS" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUPONS" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Product Grid Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tab_shop_categories"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading Shimmer State -->
    <ProgressBar
        android:id="@+id/progress_shop_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="@color/azul_neon"
        app:layout_constraintTop_toTopOf="@id/rv_products"
        app:layout_constraintBottom_toBottomOf="@id/rv_products"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error State Overlay -->
    <LinearLayout
        android:id="@+id/layout_shop_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_products"
        app:layout_constraintBottom_toBottomOf="@id/rv_products"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_shop_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Não foi possível carregar a vitrine da arena."
            android:textColor="@color/vermelho_neon"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_shop_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar Novamente"
            android:textColor="#000000"
            android:background="@drawable/bg_button_neon"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
