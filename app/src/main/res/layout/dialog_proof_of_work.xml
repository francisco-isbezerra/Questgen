<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_principal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para validar a sua vitória, envie um print de tela da partida concluída."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecione um arquivo da Galeria ou digite a URL:"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_select_gallery"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_dark"
        android:text="SELECIONAR DA GALERIA (PRINT)"
        android:textColor="@color/azul_neon"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@null"
        app:strokeColor="@color/azul_neon"
        app:strokeWidth="1dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="URL do Comprovante"
        android:textColorHint="@color/gray_text"
        app:boxStrokeColor="@color/azul_neon"
        app:hintTextColor="@color/azul_neon"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_proof_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
