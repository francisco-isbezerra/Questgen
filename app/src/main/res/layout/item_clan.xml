<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/bg_secundario">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- Rank Number -->
        <TextView
            android:id="@+id/tv_clan_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Logo Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_clan_logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="19dp"
            app:cardBackgroundColor="@color/bg_principal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_clan_rank">

            <ImageView
                android:id="@+id/img_clan_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_ranking"
                android:scaleType="centerCrop"
                app:tint="@color/azul_neon"
                android:padding="6dp" />
        </androidx.cardview.widget.CardView>

        <!-- Clan Tag & Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_clan_logo"
            app:layout_constraintEnd_toStartOf="@id/tv_clan_xp">

            <TextView
                android:id="@+id/tv_clan_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ALP]"
                android:textColor="@color/azul_neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_clan_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alpha Esports"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- XP Score -->
        <TextView
            android:id="@+id/tv_clan_xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12,500 XP"
            android:textColor="@color/verde_vibrante"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
