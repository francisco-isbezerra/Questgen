<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_principal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header Dynamic Title -->
        <TextView
            android:id="@+id/tv_challenge_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE KINETIC VOID PHASE"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Countdown Timer Pill -->
        <LinearLayout
            android:id="@+id/layout_countdown_timer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_timer_pill"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_challenge_detail_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:tint="#FFD700"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:59:20"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Challenge Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_challenge_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bg_secundario"
            app:layout_constraintTop_toBottomOf="@id/layout_countdown_timer">

            <!-- Borda interna programática ou estilizada -->
            <LinearLayout
                android:id="@+id/layout_challenge_border"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_neon">

                <!-- Badge Rarity and Difficulty -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_detail_rarity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LENDÁRIO"
                        android:textColor="@color/raridade_lendario"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#2E2800"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Difficulty blocks (5/5) -->
                    <TextView
                        android:id="@+id/tv_difficulty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIFICULDADE: 5/5"
                        android:textColor="#FFD700"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Exact Mission Text -->
                <TextView
                    android:id="@+id/tv_detail_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Marcar um gol de goleiro do meio de campo."
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <!-- Reward amount -->
                <TextView
                    android:id="@+id/tv_detail_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+200 GameCoins"
                    android:textColor="@color/verde_vibrante"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dynamic Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_detail_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/card_challenge_details">

            <!-- ACEITAR DESAFIO (Primary blue neon) -->
            <Button
                android:id="@+id/btn_accept"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_neon"
                android:text="ACEITAR DESAFIO"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp"
                app:backgroundTint="@null" />

            <!-- REIVINDICAR RECOMPENSA (Secondary green or white) -->
            <Button
                android:id="@+id/btn_claim"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_dark"
                android:text="REIVINDICAR RECOMPENSA"
                android:textColor="@color/verde_vibrante"
                android:textStyle="bold"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:strokeColor="@color/verde_vibrante"
                app:strokeWidth="1dp" />

            <!-- DESISTIR (Danger/Abort dark with red outline) -->
            <Button
                android:id="@+id/btn_forfeit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_dark"
                android:text="ABANDONAR DESAFIO"
                android:textColor="@color/vermelho_neon"
                android:textStyle="bold"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:strokeColor="@color/vermelho_neon"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Loader Action Progress -->
        <ProgressBar
            android:id="@+id/progress_challenge_action"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone"
            android:indeterminateTint="@color/azul_neon"
            app:layout_constraintTop_toTopOf="@id/layout_detail_actions"
            app:layout_constraintBottom_toBottomOf="@id/layout_detail_actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Next Expeditions List Preview -->
        <TextView
            android:id="@+id/tv_header_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT EXPEDITIONS"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toBottomOf="@id/layout_detail_actions"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/bg_secundario"
            app:layout_constraintTop_toBottomOf="@id/tv_header_next"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Ataque Furtivo de Neon (+100 GC)"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Neural Network Override (+150 GC)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
