<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal"
    android:padding="20dp">

    <!-- Top Navigation Bar -->
    <ImageView
        android:id="@+id/btn_back_edit_profile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/white"
        android:padding="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_edit_profile_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDITAR PERFIL"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btn_back_edit_profile"
        app:layout_constraintBottom_toBottomOf="@id/btn_back_edit_profile"
        app:layout_constraintStart_toEndOf="@id/btn_back_edit_profile"
        android:layout_marginStart="16dp" />

    <!-- Profile Image Container with Alterar Foto button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layout_edit_avatar_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="60dp"
        app:cardBackgroundColor="@color/bg_secundario"
        app:layout_constraintTop_toBottomOf="@id/btn_back_edit_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_edit_profile_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:tint="@color/azul_neon"
            android:padding="8dp" />

        <!-- Alterar Foto Overlay Banner -->
        <FrameLayout
            android:id="@+id/btn_change_photo"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ALTERAR"
                android:textColor="@color/azul_neon"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Name Label -->
    <TextView
        android:id="@+id/tv_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOME DE USUÁRIO"
        android:textColor="@color/gray_text"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/layout_edit_avatar_container"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Name Input Field -->
    <EditText
        android:id="@+id/et_edit_profile_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:hint="Digite seu nome"
        android:textColorHint="@color/gray_text"
        android:maxLines="1"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/tv_name_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save Button -->
    <TextView
        android:id="@+id/tv_desc_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BIOGRAFIA / DESCRIÇÃO"
        android:textColor="@color/gray_text"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/et_edit_profile_name"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_edit_profile_desc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:hint="Fale um pouco sobre você"
        android:textColorHint="@color/gray_text"
        android:maxLines="3"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@id/tv_desc_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_save_profile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_button_neon"
        android:text="SALVAR ALTERAÇÕES"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/et_edit_profile_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading overlay -->
    <ProgressBar
        android:id="@+id/progress_edit_profile_load"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="@color/azul_neon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
