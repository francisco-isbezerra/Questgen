<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/bg_secundario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- History Icon indicator -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_games"
            app:tint="@color/verde_vibrante"
            android:layout_marginEnd="12dp" />

        <!-- Title of quest -->
        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Neural Network Breach"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Coin reward and relative time metadata -->
        <TextView
            android:id="@+id/tv_history_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+450 GC, há 3 horas"
            android:textColor="@color/verde_vibrante"
            android:textSize="11sp"
            android:layout_marginStart="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
