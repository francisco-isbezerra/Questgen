<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_principal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Avatar Container -->
        <FrameLayout
            android:id="@+id/layout_avatar_container"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="45dp"
                app:cardBackgroundColor="@color/bg_secundario">

                <ImageView
                    android:id="@+id/img_profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile"
                    android:scaleType="centerCrop"
                    android:padding="8dp"
                    app:tint="@color/azul_neon" />
            </androidx.cardview.widget.CardView>

            <!-- Edit Floating Icon -->
            <androidx.cardview.widget.CardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/azul_neon"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_edit"
                    android:padding="7dp"
                    app:tint="#000000"
                    android:scaleType="centerInside" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova_Protocol"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/layout_avatar_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title Tag Badge -->
        <TextView
            android:id="@+id/tv_profile_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEGENDARY EXPLORER"
            android:textColor="@color/raridade_lendario"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#2E2800"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle details -->
        <TextView
            android:id="@+id/tv_profile_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sincronizando a realidade com os objetivos digitais. Nível 42."
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_tag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stats Blocks Grid -->
        <LinearLayout
            android:id="@+id/layout_stats_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_sub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Completed Stats Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/bg_secundario">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPLETADOS"
                        android:textColor="@color/gray_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="482 ▲ 12%"
                        android:textColor="@color/verde_vibrante"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Win Rate Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/bg_secundario">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAXA DE VITÓRIA"
                        android:textColor="@color/gray_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="84% ELITE"
                        android:textColor="@color/azul_neon"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Current Rank Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_current_rank"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/bg_secundario"
            app:layout_constraintTop_toBottomOf="@id/layout_stats_grid">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_ranking"
                    app:tint="@color/raridade_lendario" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATENTE ATUAL"
                        android:textColor="@color/gray_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master III - Top 3.2% Global"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- History Header -->
        <TextView
            android:id="@+id/tv_header_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHALLENGE HISTORY"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/card_current_rank"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- History Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_header_history"
            app:layout_constraintBottom_toTopOf="@id/btn_logout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="SAIR DA ARENA"
            android:textColor="@color/vermelho_claro"
            android:textStyle="bold"
            android:textSize="14sp"
            app:strokeColor="@color/vermelho_claro"
            app:strokeWidth="1.2dp"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/rv_history"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Excluir Conta Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_account"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="EXCLUIR CONTA"
            android:textColor="#FF4C4C"
            android:textStyle="bold"
            android:textSize="14sp"
            app:strokeColor="#FF4C4C"
            app:strokeWidth="1.2dp"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/btn_logout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
