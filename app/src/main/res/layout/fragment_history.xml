<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal"
    android:padding="16dp">

    <!-- Back Button (Seta Superior) -->
    <ImageView
        android:id="@+id/btn_back_history"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/white"
        android:padding="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Header Title -->
    <TextView
        android:id="@+id/tv_history_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HISTÓRICO DE EXPEDIÇÕES"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btn_back_history"
        app:layout_constraintBottom_toBottomOf="@id/btn_back_history"
        app:layout_constraintStart_toEndOf="@id/btn_back_history"
        android:layout_marginStart="16dp" />

    <!-- Subtitle Meta -->
    <TextView
        android:id="@+id/tv_history_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desafios concluídos, falhados ou abandonados"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back_history"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tv_history_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nenhuma expedição registrada no seu histórico ainda."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView for list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_history_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_history" />

</androidx.constraintlayout.widget.ConstraintLayout>
