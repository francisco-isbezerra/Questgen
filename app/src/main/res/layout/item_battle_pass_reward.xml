<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_secundario">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Left vertical bar or indicator for Level -->
        <TextView
            android:id="@+id/tv_reward_level"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="NÍVEL 5"
            android:textColor="@color/azul_neon"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#122438"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Reward Info Section -->
        <LinearLayout
            android:id="@+id/layout_reward_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_reward_level"
            app:layout_constraintEnd_toStartOf="@+id/layout_reward_status">

            <TextView
                android:id="@+id/tv_reward_tier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSE PREMIUM"
                android:textColor="@color/raridade_lendario"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tv_reward_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moldura Neon Ciano"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_reward_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desbloqueia uma moldura futurista para o seu avatar."
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Right Action / Status Area -->
        <FrameLayout
            android:id="@+id/layout_reward_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- State 1: Claim Button -->
            <Button
                android:id="@+id/btn_claim_reward"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_neon"
                android:text="RESGATAR"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                app:backgroundTint="@null"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- State 2: Claimed Indicator -->
            <TextView
                android:id="@+id/tv_claimed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESGATADO"
                android:textColor="@color/verde_vibrante"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1B3320"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="gone" />

            <!-- State 3: Locked Indicator -->
            <LinearLayout
                android:id="@+id/layout_locked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2E1B1B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/vermelho_neon"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOQUEADO"
                    android:textColor="@color/vermelho_neon"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
