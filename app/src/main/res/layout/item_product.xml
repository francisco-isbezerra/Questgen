<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/bg_secundario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Product Image -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#141414"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="8dp" />

            <!-- Category / Rarity Tag Badge -->
            <TextView
                android:id="@+id/tv_product_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LENDÁRIO"
                android:textColor="@color/raridade_lendario"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#2E2800"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_margin="6dp"
                android:layout_gravity="top|start" />
        </FrameLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Neon-Strike Pro"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <!-- Price in Green -->
        <TextView
            android:id="@+id/tv_product_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15,000 GC"
            android:textColor="@color/verde_vibrante"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Buy Action Button -->
        <Button
            android:id="@+id/btn_buy_product"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_neon"
            android:text="TROCAR"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            android:padding="0dp"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
