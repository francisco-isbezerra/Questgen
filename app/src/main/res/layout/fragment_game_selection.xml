<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal"
    android:padding="20dp">

    <!-- Header info -->
    <TextView
        android:id="@+id/tv_title_games"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecione seu Jogo"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_desc_games"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escolha sua arena de batalha para sincronizar suas conquistas e começar a gerar recompensas exclusivas."
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_games" />

    <!-- RecyclerView for games -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_games"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_desc_games"
        app:layout_constraintBottom_toTopOf="@id/tv_suggest_game"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading Shimmer State -->
    <ProgressBar
        android:id="@+id/progress_games_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="@color/azul_neon"
        app:layout_constraintTop_toTopOf="@id/rv_games"
        app:layout_constraintBottom_toBottomOf="@id/rv_games"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error State Overlay -->
    <LinearLayout
        android:id="@+id/layout_games_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_games"
        app:layout_constraintBottom_toBottomOf="@id/rv_games"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Falha ao carregar as arenas de batalha"
            android:textColor="@color/vermelho_neon"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_games_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar Novamente"
            android:textColor="#000000"
            android:background="@drawable/bg_button_neon"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Bottom link option -->
    <TextView
        android:id="@+id/tv_suggest_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Não encontrou seu jogo? Sugerir Jogo"
        android:textColor="@color/azul_neon"
        android:textSize="13sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
